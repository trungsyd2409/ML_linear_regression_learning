   "source": [
    "from sklearn.linear_model import LinearRegression\n",
    "import seaborn as sns, statsmodels.formula.api as smf\n",
    "df = sns.load_dataset(\"mpg\").dropna()\n",
    "df.head()\n",
    "\n",
    "m = smf.ols(\"mpg ~ weight + horsepower + C(origin)\", data=df).fit()\n",
    "print(m.summary())"
   ]
